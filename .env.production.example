# Build-time (NEXT_PUBLIC_*) — informatif saja, nilai sebenarnya dari GitHub
# Secrets saat build. Mengisi ini di VPS TIDAK berpengaruh ke nilai yang
# sudah terpanggang dalam image.
NEXT_PUBLIC_APP_URL=https://amarizzal.dev

# Runtime — dibaca container saat jalan, aman diisi di sini.
# TIDAK di-commit ke git (lihat .gitignore) — ini hanya template.

# Postgres milik project ssb-poultry, dipakai bersama (lihat db/CATATAN-INFRA.md).
# Host WAJIB "ssb-db" (alias di network db_shared) — BUKAN "db" dan BUKAN
# localhost. Password dibuat lewat SQL di db/CATATAN-INFRA.md §Setup awal.
DATABASE_URL=postgresql://amarizzal:GANTI_DENGAN_PASSWORD@ssb-db:5432/amarizzal_dev

# Rahasia penandatanganan sesi JWT (cookie amz_session + proxy.ts).
# Generate dengan: openssl rand -hex 32
SESSION_SECRET=

# Akun admin awal, dibaca SEKALI oleh `npm run db:seed`. Setelah seed
# pertama jalan, ganti ADMIN_PASSWORD di sini tidak berpengaruh lagi --
# kata sandi sudah tersimpan sebagai hash di tabel users.
ADMIN_EMAIL=rizalama11.ra@gmail.com
ADMIN_PASSWORD=

# PENTING — urutan deploy: file .env.production ini harus SUDAH ada dan
# terisi di droplet SEBELUM image pertama yang membawa `pg` di-deploy.
# Kalau tidak, container crash-loop karena DATABASE_URL/SESSION_SECRET
# kosong. Lihat db/CATATAN-INFRA.md.
